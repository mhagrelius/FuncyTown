<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>FuncyTown.Sample</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    The in-tree sample uses ProjectReference for fast dev iteration. To validate the
    actual shipped meta-package surface (analyzers + code fixes installed via NuGet),
    use scripts/pack-and-test.sh, which packs the meta and consumes it from a local feed.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\FuncyTown.Abstractions\FuncyTown.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\FuncyTown.Generators\FuncyTown.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\FuncyTown.Analyzers\FuncyTown.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\FuncyTown.Analyzers.CodeFixes\FuncyTown.Analyzers.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
