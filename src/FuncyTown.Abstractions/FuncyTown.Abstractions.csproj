<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FuncyTown</RootNamespace>
    <AssemblyName>FuncyTown.Abstractions</AssemblyName>
    <PackageId>FuncyTown.Abstractions</PackageId>
    <Description>Runtime types and attributes for FuncyTown — strongly-typed Result&lt;T, TError&gt; for C# 14 / .NET 10.</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
